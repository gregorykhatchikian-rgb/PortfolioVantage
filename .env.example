# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# NVIDIA NIM (build.nvidia.com) - free developer account, no credit card
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Model id from the build.nvidia.com catalog. The catalog changes over time, so
# verify_phase0.py checks this id actually exists before making a call.
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# AlphaVantage - earnings call transcripts (Phase 2)
# Free key, instant, email only: https://www.alphavantage.co/support/#api-key
# Free tier is ~25 requests/day. Transcripts are cached locally so reruns cost nothing.
ALPHAVANTAGE_API_KEY=xxxxxxxxxxxxxxxx

# Financial Modeling Prep - unused. Kept only because DividendPredict shares this key.
# Its transcript endpoints sit behind paid tiers; AlphaVantage is the Phase 2 source.
FMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
